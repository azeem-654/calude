# The API directory. Endpoints are the .php files here; everything else is
# either a shared include or private state and must not be served.

Options -Indexes

# Shared includes (_db.php, _perm.php, _mail.php) and the database credentials
# are never entry points. They are harmless if executed, but denying them keeps
# the credentials unreachable if PHP is ever misconfigured and serves source.
<FilesMatch "^(_.*\.php|config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Belt and braces for the state directory, in case its own .htaccess is lost.
RedirectMatch 404 ^/api/data/
